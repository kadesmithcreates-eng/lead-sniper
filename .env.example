# ── Gemini AI ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Discord Notifications ───────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# ── Telegram (optional — leave blank to skip) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── IPRoyal Residential Proxy ───────────────────
# Leave blank to skip proxy (not recommended)
IPROYAL_PROXY_HOST=geo.iproyal.com
IPROYAL_PROXY_PORT=12321
IPROYAL_USERNAME=your_iproyal_username
IPROYAL_PASSWORD=your_iproyal_password

# ── Dashboard ───────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_PASSWORD=changeme
DASHBOARD_URL=http://your-vps-ip:3000
JWT_SECRET=change-this-to-a-long-random-string
